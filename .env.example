# PostgreSQL
POSTGRES_DB=syphership
POSTGRES_USER=syphership
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API
API_PORT=8000

# Notification Service
NOTIFICATION_PORT=8001

# Auth
SECRET_KEY=generate_with_python_-c_"import secrets; print(secrets.token_urlsafe(48))"
FRONTEND_URL=http://localhost:5173

# GitHub OAuth app (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/github/callback

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback

# Resource limits for each deployed container (docker run --cpus / --memory)
DEPLOYMENT_CPUS=0.5
DEPLOYMENT_MEMORY=256m
DEPLOYMENT_PIDS_LIMIT=256

# Docker network for deployed apps (create once: docker network create syphership-apps)
DEPLOYMENT_NETWORK=syphership-apps

# Shared secret for GitHub push webhooks (generate: python -c "import secrets; print(secrets.token_hex(32))")
GITHUB_WEBHOOK_SECRET=0ac75b02cfb270e98ea769b5f739c3002ac7842c1b2f6d84b495945447fc2fda
