# PostgreSQL
POSTGRES_DB=syphership
POSTGRES_USER=syphership
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API
API_PORT=8000

# Notification Service
NOTIFICATION_PORT=8001

# Auth
SECRET_KEY=generate_with_python_-c_"import secrets; print(secrets.token_urlsafe(48))"
FRONTEND_URL=http://localhost:5173

# GitHub OAuth app (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/github/callback

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback

# Resource limits for each deployed container (docker run --cpus / --memory)
DEPLOYMENT_CPUS=0.5
DEPLOYMENT_MEMORY=256m
DEPLOYMENT_PIDS_LIMIT=256

# Docker network for deployed apps (create once: docker network create syphership-apps)
DEPLOYMENT_NETWORK=syphership-apps

# Public address of this API, so GitHub can reach it. Webhooks are created with this URL.
PUBLIC_API_URL=

# Invite-only: comma-separated emails allowed to create an account. Empty means anyone can sign up.
ALLOWED_EMAILS=

# Limits
MAX_APPS_PER_USER=3
DEPLOYMENT_MAX_IMAGE_MB=2048
DEPLOYMENT_MAX_REPO_MB=500

# Public app URLs (server only). Each app gets https://<name>-<project id>.<APPS_DOMAIN>,
# routed by Caddy. Leave empty locally: apps then use http://localhost:<port>.
APPS_DOMAIN=
# Host folder with Caddy's config, mounted into the worker. Server: /etc/caddy
CADDY_DIR=
# Host folder with Caddy's per-app access logs (read-only in the worker). Server: /var/log/caddy/apps
CADDY_LOG_DIR=

# Apps nobody visits for this many hours are stopped, and start again on the next visit.
# Only with APPS_DOMAIN. 0 turns it off.
IDLE_SLEEP_HOURS=24

# Logs: "json" (one JSON object per line, for production) or "text" (readable, for local).
LOG_FORMAT=json
LOG_LEVEL=INFO

# GET /metrics (Prometheus). Set a long random token in production; Prometheus
# then sends "Authorization: Bearer <token>". Empty: /metrics is open (local only).
METRICS_TOKEN=
